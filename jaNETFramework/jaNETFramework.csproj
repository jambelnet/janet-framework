<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>jaNET</RootNamespace>
    <AssemblyName>jaNETFramework</AssemblyName>
    <Copyright>Copyright (c) 2010-2026 J@mBeL.net</Copyright>
    <IsPackable>true</IsPackable>
    <PackageId>jaNETFramework</PackageId>
    <Description>jaNET Framework: an instruction runner for home automation and IoT with a scheduler, events, a web server with the Jubito UI, a socket server, serial port and mail/SMS/weather services. Embed it in your own application and extend it with your own commands and functions.</Description>
    <PackageTags>jaNET;iot;home-automation;automation;scheduler;arduino;raspberry-pi</PackageTags>
    <PackageReadmeFile>PackageReadme.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="PackageReadme.md" Pack="true" PackagePath="\" />
    <!-- the web UI travels with the package; buildTransitive/jaNETFramework.targets copies it into the output of the consuming project -->
    <None Include="buildTransitive\jaNETFramework.targets" Pack="true" PackagePath="buildTransitive\" />
    <None Include="buildTransitive\jaNETFramework.Speech.targets" Pack="true" PackagePath="buildTransitive\" />
    <None Include="..\www\**\*" Pack="true" PackagePath="buildTransitive\www\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kestrel: the web server (http and https). Needs the ASP.NET Core runtime next to the .NET runtime. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="Vosk" Version="0.3.38" ExcludeAssets="build;buildTransitive" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.0.0" />
    <PackageReference Include="MQTTnet" Version="5.2.0.1603" />
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\DefaultAppConfig.xml" LogicalName="DefaultAppConfig.xml" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="jaNETFramework.Tests" />
  </ItemGroup>

  <Import Project="buildTransitive\jaNETFramework.Speech.targets" />

</Project>
