<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- test code: nullable annotations and the style rules of the recommended profile would only add noise -->
    <Nullable>disable</Nullable>
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageReference Include="MQTTnet.Server" Version="5.2.0.1603" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Service tests own background workers and finite deadlines; keep unrelated collections from competing. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="..\tools\ReleasePackager\ReleaseArchive.cs" Link="ReleaseArchive.cs" />
    <ProjectReference Include="..\tools\ProcessProbe\ProcessProbe.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\jaNETFramework\jaNETFramework.csproj" />
    <ProjectReference Include="..\jaNETFramework.Hosting\jaNETFramework.Hosting.csproj" />
    <ProjectReference Include="..\jaNETProgram\jaNETProgram.csproj" />
  </ItemGroup>

</Project>
