<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>jaNETFramework.Hosting</AssemblyName>
    <RootNamespace>jaNET.Hosting</RootNamespace>
    <PackageId>jaNETFramework.Hosting</PackageId>
    <Description>Runs jaNET Framework as a background service of a .NET generic host (Worker Service, ASP.NET Core): services.AddJanet().</Description>
    <PackageTags>jaNET;iot;home-automation;hosting;background-service</PackageTags>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\jaNETFramework\jaNETFramework.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
  </ItemGroup>

</Project>
