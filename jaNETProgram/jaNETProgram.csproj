<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>jaNETProgram</RootNamespace>
    <AssemblyName>jaNETProgram</AssemblyName>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="jaNETFramework.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\jaNETFramework\jaNETFramework.csproj" />
  </ItemGroup>

  <!-- The Jubito web UI is served from <application directory>/www, so ship it with the program. -->
  <ItemGroup>
    <Content Include="..\www\**\*" Link="www\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

</Project>
